{
  "name": "synterra",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "test": "node --test",
    "agents:init": "node --env-file-if-exists=.env src/agent-runtime/bootstrap.js",
    "agents:run": "node --env-file-if-exists=.env src/agent-runtime/run.js"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0",
    "ethers": "^6.17.0",
    "fastify": "^5.6.2",
    "pg": "^8.16.3"
  }
}
