# Production startup validates existing schema/migrations read-only. Apply migrations explicitly first.
SYNTERRA_SCHEMA_MODE=validate
NODE_ENV=production
HOST=127.0.0.1
PORT=8787

# Required: set only after the production PostgreSQL provider/endpoint is selected.
DATABASE_URL=
SYNTERRA_STATE_DIR=/var/lib/synterra/.synterra

# Arc Mainnet read-only network config. RPC values must be official Arc Mainnet endpoints.
ARC_ENV=mainnet
ARC_RPC_URL=https://rpc.mainnet.arc.io
ARC_RPC_FALLBACK_URLS=

# Pending until the user supplies a real Mainnet signer and deployed contracts.
ARC_SIGNER_PROVIDER=
ARC_SIGNER_ADAPTER_MODULE=
ARC_DEPLOYER_ADDRESS=
ARC_WORLD_TREASURY_ADDRESS=
ARC_SETTLEMENT_CONTRACT_ADDRESS=
ARC_SETTLEMENT_RUNTIME_CODE_HASH=
ARC_WORLD_REGISTRY_ADDRESS=
ARC_CAPABILITY_PROVENANCE_ADDRESS=
ARC_SETTLEMENT_DEPLOYMENT_BLOCK=
ARC_USDC_INDEXER_START_BLOCK=

# Optional application integrations. Never put keys in source control.
TYPESAFE_API_KEY=
